PORT=5000
# Frontend origin(s) allowed to call this API, comma separated
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas connection string (free tier works)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/memoai
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# https://console.groq.com (free)
GROQ_API_KEY=
# https://aistudio.google.com (free) used only for embeddings
GEMINI_API_KEY=
# https://cloud.qdrant.io (free 1GB cluster)
QDRANT_URL=
QDRANT_API_KEY=
